{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.poietek.local/audio-health-report/v1",
  "title": "Poietek Audio Health Report v1",
  "type": "object",
  "required": [
    "reportId",
    "assetOrStreamId",
    "analysisVersion",
    "createdAt",
    "measurements",
    "findings",
    "recommendations"
  ],
  "properties": {
    "reportId": {
      "type": "string"
    },
    "assetOrStreamId": {
      "type": "string"
    },
    "analysisVersion": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "measurements": {
      "type": "object",
      "properties": {
        "samplePeakDbfs": {
          "type": [
            "number",
            "null"
          ]
        },
        "truePeakDbtp": {
          "type": [
            "number",
            "null"
          ]
        },
        "rmsDbfs": {
          "type": [
            "number",
            "null"
          ]
        },
        "integratedLufs": {
          "type": [
            "number",
            "null"
          ]
        },
        "shortTermLufsMax": {
          "type": [
            "number",
            "null"
          ]
        },
        "momentaryLufsMax": {
          "type": [
            "number",
            "null"
          ]
        },
        "loudnessRangeLu": {
          "type": [
            "number",
            "null"
          ]
        },
        "dcOffset": {
          "type": [
            "number",
            "null"
          ]
        },
        "clippedSampleCount": {
          "type": "integer",
          "minimum": 0
        },
        "nearClipEventCount": {
          "type": "integer",
          "minimum": 0
        },
        "crestFactorDb": {
          "type": [
            "number",
            "null"
          ]
        },
        "noiseFloorDbfs": {
          "type": [
            "number",
            "null"
          ]
        },
        "stereoCorrelation": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "silenceRatio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "dropoutCount": {
          "type": "integer",
          "minimum": 0
        },
        "hum": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "spectral": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "title",
          "evidence"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "advisory",
              "warning",
              "critical"
            ]
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "message",
          "confidence",
          "actionMode"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "actionMode": {
            "enum": [
              "advice_only",
              "previewable_command",
              "manual_hardware_action",
              "requires_more_measurement"
            ]
          },
          "proposedCommands": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "targetProfileId": {
      "type": [
        "string",
        "null"
      ]
    },
    "standardsCompliance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}